# Auth.js (next-auth v5)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 쉼표 구분. 여기 없는 구글 계정은 로그인 거부
ALLOWED_EMAILS=
# 선택: 화면에 보일 이름. "이메일:이름" 쉼표 구분(예: a@x.com:나,b@y.com:아내). 없으면 이메일 앞부분
MEMBER_NAMES=

# 저장소(둘 중 하나 이름만 있으면 됨). 비우면 로컬 .data/progress.json 사용
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 선택: 최종 주소(og:url, sitemap). 미정이면 비워 둠
NEXT_PUBLIC_SITE_URL=

# 로컬 개발 전용(NODE_ENV=development 일 때만 동작, 프로덕션 빌드에선 코드상 제거됨)
DEV_FAKE_LOGIN_EMAIL=
