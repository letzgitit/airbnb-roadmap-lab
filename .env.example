# Auth.js (next-auth v5)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 쉼표 구분. 여기 없는 구글 계정은 로그인 거부
ALLOWED_EMAILS=
# 선택: 화면에 보일 이름. "이메일:이름" 쉼표 구분(예: a@x.com:나,b@y.com:아내). 없으면 이메일 앞부분
MEMBER_NAMES=

# 저장소(둘 중 하나 이름만 있으면 됨). 비우면 로컬 .data/progress.json 사용
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 선택: 최종 주소(og:url, sitemap). 미정이면 비워 둠
NEXT_PUBLIC_SITE_URL=

# Todoist 동기화(선택). 🔴 실제 값은 Vercel 환경 변수에만 넣는다 — 이 파일을 복사한 .env.local 에는 넣지 않는다(공개 저장소 · 로컬 시험).
# 로컬 연습 저장소일 때는 토큰이 있어도 Todoist 로 보내지 않는다. 비우면 사이트 → Todoist 반영을 건너뛰고, 웹훅은 503
# 개인 API 토큰(Todoist 설정 → 연동 → 개발자). 사이트 → Todoist REST 호출에 쓴다
TODOIST_API_TOKEN=
# Todoist 앱(App Management Console)의 Client secret. 웹훅 서명 확인에 쓴다
TODOIST_CLIENT_SECRET=
# 웹훅을 이 Todoist 사용자 id 것만 받는다(웹훅 본문 user_id). 없으면 웹훅은 503
TODOIST_USER_ID=
# 선택: 맞출 라벨(기본 외도민) · 사이트에서 만든 할 일을 넣을 프로젝트 id(없으면 받은편지함)
TODOIST_LABEL=
TODOIST_PROJECT_ID=
# 선택: Todoist 에서 새로 들어온 할 일의 단계를 Claude 로 고른다(없으면 낱말 규칙)
ANTHROPIC_API_KEY=

# 로컬 개발 전용(NODE_ENV=development 일 때만 동작, 프로덕션 빌드에선 코드상 제거됨)
DEV_FAKE_LOGIN_EMAIL=
